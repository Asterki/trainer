{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainer.local/schemas/context-report.schema.json",
  "title": "Trainer context report",
  "description": "Compact training report returned by GET /api/v1/context and consumed by the n8n workflow. Stable objects reject unknown properties so contract drift is visible immediately.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "date",
    "generatedAt",
    "routine",
    "recentSessions",
    "exerciseStats",
    "candidates",
    "muscleVolume",
    "adherence"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "description": "Context payload version. Bump when the shape changes."
    },
    "date": {
      "$ref": "#/$defs/isoDate"
    },
    "generatedAt": {
      "$ref": "#/$defs/isoDateTime"
    },
    "routine": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/contextRoutine" }
      ],
      "description": "Today's active routine slot, or null when no routine is active."
    },
    "recentSessions": {
      "type": "array",
      "description": "Up to 6 completed or skipped sessions, same focus first.",
      "maxItems": 6,
      "items": { "$ref": "#/$defs/recentSession" }
    },
    "exerciseStats": {
      "type": "array",
      "description": "Per-exercise history for exercises in recentSessions. Capped at 20.",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/exerciseStats" }
    },
    "candidates": {
      "type": "array",
      "description": "The only exercises the model may choose from. Capped at 40.",
      "maxItems": 40,
      "items": { "$ref": "#/$defs/candidate" }
    },
    "muscleVolume": {
      "type": "array",
      "description": "Weekly muscle volume for the last 8 ISO weeks, oldest first.",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/muscleWeek" }
    },
    "adherence": {
      "$ref": "#/$defs/adherence"
    }
  },
  "$defs": {
    "isoDate": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Local calendar date, never a UTC timestamp."
    },
    "isoDateTime": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp with offset."
    },
    "muscleGroupId": {
      "type": "string",
      "enum": [
        "anterior-deltoid",
        "posterior-deltoid",
        "biceps-brachii",
        "brachialis",
        "triceps-brachii",
        "pectoralis-major",
        "latissimus-dorsi",
        "rhomboid",
        "trapezius",
        "serratus-anterior",
        "erector-spinae",
        "rectus-abdominis",
        "obliquus-externus-abdominis",
        "gluteus-maximus",
        "quadriceps-femoris",
        "hamstrings",
        "gastrocnemius",
        "soleus"
      ]
    },
    "equipmentId": {
      "type": "string",
      "enum": [
        "barbell",
        "dumbbell",
        "machine",
        "cable",
        "bodyweight",
        "kettlebell",
        "band",
        "other"
      ]
    },
    "weekday": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7,
      "description": "ISO weekday: 1 Monday through 7 Sunday."
    },
    "isoWeek": {
      "type": "string",
      "pattern": "^\\d{4}-W(0[1-9]|[1-4][0-9]|5[0-3])$",
      "description": "ISO week key, Monday-based, e.g. 2026-W45."
    },
    "contextRoutine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "weekIndex", "weekday", "focus", "isRest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "weekIndex": { "type": "integer", "minimum": 0, "maximum": 11 },
        "weekday": { "$ref": "#/$defs/weekday" },
        "focus": { "type": "string", "maxLength": 40 },
        "isRest": { "type": "boolean" }
      }
    },
    "contextSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weight", "reps"],
      "properties": {
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000,
          "description": "Kilograms. 0 means bodyweight."
        },
        "reps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999
        }
      }
    },
    "recentExercise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exerciseId", "name", "primaryMuscles", "sets", "topWeight", "volume"],
      "properties": {
        "exerciseId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "primaryMuscles": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/muscleGroupId" }
        },
        "sets": {
          "type": "array",
          "items": { "$ref": "#/$defs/contextSet" }
        },
        "topWeight": { "type": "number", "minimum": 0 },
        "volume": { "type": "number", "minimum": 0 }
      }
    },
    "recentSession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "focus", "status", "exercises"],
      "properties": {
        "date": { "$ref": "#/$defs/isoDate" },
        "focus": { "type": "string", "maxLength": 40 },
        "status": { "type": "string", "enum": ["completed", "skipped"] },
        "exercises": {
          "type": "array",
          "items": { "$ref": "#/$defs/recentExercise" }
        }
      }
    },
    "lastPerformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "sets"],
      "properties": {
        "date": { "$ref": "#/$defs/isoDate" },
        "sets": {
          "type": "array",
          "items": { "$ref": "#/$defs/contextSet" }
        }
      }
    },
    "prMap": {
      "type": "object",
      "description": "PR weight in kilograms keyed by rep count as a string, e.g. {\"5\": 95, \"8\": 80}.",
      "propertyNames": {
        "pattern": "^(?:[1-9]|[1-9][0-9]|[1-9][0-9][0-9])$"
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "exerciseStats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exerciseId", "name", "primaryMuscles", "last", "prs", "volumeTrend"],
      "properties": {
        "exerciseId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "primaryMuscles": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/muscleGroupId" }
        },
        "last": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/lastPerformance" }
          ]
        },
        "prs": { "$ref": "#/$defs/prMap" },
        "volumeTrend": {
          "type": "array",
          "description": "Volume for the last three occurrences, oldest first.",
          "maxItems": 3,
          "items": { "type": "number", "minimum": 0 }
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exerciseId", "name", "primaryMuscles", "secondaryMuscles", "equipment"],
      "properties": {
        "exerciseId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "primaryMuscles": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/muscleGroupId" }
        },
        "secondaryMuscles": {
          "type": "array",
          "items": { "$ref": "#/$defs/muscleGroupId" }
        },
        "equipment": {
          "type": "array",
          "items": { "$ref": "#/$defs/equipmentId" }
        }
      }
    },
    "muscleVolumeMap": {
      "type": "object",
      "additionalProperties": false,
      "description": "Volume in kilograms per muscle. Omitted muscles are zero.",
      "properties": {
        "anterior-deltoid": { "type": "number", "minimum": 0 },
        "posterior-deltoid": { "type": "number", "minimum": 0 },
        "biceps-brachii": { "type": "number", "minimum": 0 },
        "brachialis": { "type": "number", "minimum": 0 },
        "triceps-brachii": { "type": "number", "minimum": 0 },
        "pectoralis-major": { "type": "number", "minimum": 0 },
        "latissimus-dorsi": { "type": "number", "minimum": 0 },
        "rhomboid": { "type": "number", "minimum": 0 },
        "trapezius": { "type": "number", "minimum": 0 },
        "serratus-anterior": { "type": "number", "minimum": 0 },
        "erector-spinae": { "type": "number", "minimum": 0 },
        "rectus-abdominis": { "type": "number", "minimum": 0 },
        "obliquus-externus-abdominis": { "type": "number", "minimum": 0 },
        "gluteus-maximus": { "type": "number", "minimum": 0 },
        "quadriceps-femoris": { "type": "number", "minimum": 0 },
        "hamstrings": { "type": "number", "minimum": 0 },
        "gastrocnemius": { "type": "number", "minimum": 0 },
        "soleus": { "type": "number", "minimum": 0 }
      }
    },
    "muscleWeek": {
      "type": "object",
      "additionalProperties": false,
      "required": ["week", "muscles"],
      "properties": {
        "week": { "$ref": "#/$defs/isoWeek" },
        "muscles": { "$ref": "#/$defs/muscleVolumeMap" }
      }
    },
    "adherence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weeks", "scheduled", "completed", "skipped", "rate"],
      "properties": {
        "weeks": { "type": "integer", "minimum": 0, "maximum": 52 },
        "scheduled": { "type": "integer", "minimum": 0 },
        "completed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "rate": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1,
          "description": "completed / (completed + skipped), or null when no outcome exists."
        }
      }
    }
  }
}
